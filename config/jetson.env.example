# prepare_jetson.sh 実行後、JetPack に一致する NVIDIA 配布の aarch64 wheel URL を設定する。
# 例（JetPack 5.1.1 / Python 3.8 の一例。自分のJetPackとPythonに必ず合わせる）:
# TORCH_WHEEL_URL=https://developer.download.nvidia.com/compute/redist/jp/v511/pytorch/torch-2.0.0+nv23.05-cp38-cp38-linux_aarch64.whl

# JetPack 6.2以降は、NVIDIA PyTorch コンテナを使う方が確実な場合がある。
TORCH_WHEEL_URL=
